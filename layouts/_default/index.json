{{- define "partials/inline/search-text.html" -}}
  {{- /* Math is indexed as its TeX source; rendering it would emit MathML and HTML copies of every formula. */}}
  {{- $code := "\x60$1\x60" -}}
  {{- $md := . | replaceRE `(?s)\$\$(.+?)\$\$` $code | replaceRE `\$([^$\n]+?)\$` $code -}}
  {{- return trim ($md | markdownify | plainify | htmlUnescape) " \t\r\n" -}}
{{- end -}}

{{- define "partials/inline/search-record.html" -}}
  {{- $text := partial "inline/search-text.html" .content -}}
  {{- $record := "" -}}
  {{- if $text -}}
    {{- $record = merge .base (dict "section" .section "anchor" .anchor "content" $text) -}}
  {{- end -}}
  {{- return $record -}}
{{- end -}}

{{- $index := slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Layout `site-search`) -}}
    {{- $page := . -}}
    {{- $tags := slice -}}
    {{- range $page.Params.tags -}}
      {{- $tags = $tags | append (printf "%s" .) -}}
    {{- end -}}
    {{- $date := "" -}}
    {{- if not $page.Date.IsZero -}}
      {{- $date = $page.Date.Format "2006-01-02" -}}
    {{- end -}}
    {{- $base := dict
      "title" $page.Title
      "permalink" $page.Permalink
      "summary" (trim ($page.Summary | plainify | htmlUnescape) " \t\r\n")
      "tags" $tags
      "date" $date
    -}}
    {{- $section := $page.Title -}}
    {{- $anchor := "" -}}
    {{- $content := "" -}}
    {{- range split $page.RawContent "\n" -}}
      {{- if findRE `^#{1,6}\s+.+` . -}}
        {{- with partial "inline/search-record.html" (dict "base" $base "section" $section "anchor" $anchor "content" $content) -}}
          {{- $index = $index | append . -}}
        {{- end -}}
        {{- $section = trim (. | replaceRE `^#{1,6}\s+` "" | replaceRE `\s+\{#[-A-Za-z0-9_]+\}\s*$` "" | replaceRE "`" "" | replaceRE `\[(.*?)\]\(.*?\)` "$1" | replaceRE `[*_~]` "" | htmlUnescape) " \t\r\n" -}}
        {{- $anchor = $section | anchorize -}}
        {{- $content = "" -}}
      {{- else -}}
        {{- $content = printf "%s\n%s" $content . -}}
      {{- end -}}
    {{- end -}}
    {{- with partial "inline/search-record.html" (dict "base" $base "section" $section "anchor" $anchor "content" $content) -}}
      {{- $index = $index | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
